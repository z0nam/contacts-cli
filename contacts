#!/usr/bin/env python3
"""contacts — read macOS Contacts (연락처 / AddressBook), read-only.

Subcommands:
  contacts <query>                 이름·소속·번호·이메일 부분일치로 카드 목록
  contacts search <query> [--json] (위와 동일; 명시형)
  contacts show <query> [--json]   단일 인물 전체 카드(여러 매칭이면 후보 제시)
  contacts lookup <handle> [--json] 역방향: 전화/이메일 → 이름
  contacts list [--limit N] [--json] 전체 연락처 간략 목록

Reads ~/Library/Application Support/AddressBook/**/AddressBook-v22.abcddb.
각 DB는 mode=ro&immutable=1 URI로 직접 열며 원본은 절대 건드리지 않는다.
AddressBook은 Full Disk Access 없이도 읽힌다(메시지 chat.db와 다름).
여러 소스(iCloud/Google/local)를 합치고 중복은 병합한다.
"""
import argparse
import glob
import json
import os
import re
import sqlite3
import subprocess
import sys
from datetime import datetime

COCOA_EPOCH = 978307200  # 1970-01-01 ~ 2001-01-01 UTC 사이 초

ADDRESSBOOK_DIR = os.path.expanduser("~/Library/Application Support/AddressBook")
ADDRESSBOOK_GLOB = os.path.join(ADDRESSBOOK_DIR, "**", "AddressBook-v22.abcddb")
ADDRESSBOOK_MAIN = os.path.join(ADDRESSBOOK_DIR, "AddressBook-v22.abcddb")

# 한국어가 로케일과 무관하게 깨지지 않도록 stdout을 UTF-8로.
try:
    sys.stdout.reconfigure(encoding="utf-8")
    sys.stderr.reconfigure(encoding="utf-8")
except Exception:
    pass


def _die(msg, code=1):
    print(msg, file=sys.stderr)
    sys.exit(code)


# --------------------------------------------------------------------------
# 헬퍼 (messages-cli/msg 와 동일 규약: CJK 이름 조합, 숫자 추출)
# --------------------------------------------------------------------------
def _has_cjk(s):
    return any(
        "぀" <= ch <= "鿿"
        or "가" <= ch <= "힣"
        or "豈" <= ch <= "﫿"
        for ch in s
    )


def digits(s):
    return re.sub(r"\D", "", s or "")


def compose_name(first, last, middle, nick, org):
    """macOS가 보여주는 방식의 표시 이름(CJK = 성+이름)."""
    first = (first or "").strip()
    last = (last or "").strip()
    middle = (middle or "").strip()
    if first or last or middle:
        if _has_cjk(first + last + middle):
            # 한국어/한자/일본어: 성 + 이름 (중간이름은 이름 뒤에 붙임)
            return ((last or "") + (first or "") + (middle or "")) or None
        parts = [p for p in (first, middle, last) if p]
        return " ".join(parts) or None
    for alt in (nick, org):
        if alt and alt.strip():
            return alt.strip()
    return None


def clean_label(label):
    """ZLABEL 정규화: '_$!<Mobile>!$_' → 'mobile'. 커스텀 라벨은 그대로(소문자)."""
    if not label:
        return None
    m = re.match(r"_\$!<(.+?)>!\$_", label)
    if m:
        return m.group(1).lower()
    s = label.strip()
    return s.lower() if s else None


def cocoa_to_date(value):
    """Cocoa TIMESTAMP → 'YYYY-MM-DD'(시간 무시). 실패하면 None."""
    if not value:
        return None
    try:
        unix = float(value) + COCOA_EPOCH
        return datetime.fromtimestamp(unix).strftime("%Y-%m-%d")
    except (OverflowError, OSError, ValueError, TypeError):
        return None


# --------------------------------------------------------------------------
# AddressBook 로딩 (read-only, 멀티소스 병합)
# --------------------------------------------------------------------------
class Card:
    """병합된 연락처 1건."""

    __slots__ = ("name", "first", "last", "middle", "nickname", "org",
                 "title", "department", "birthday", "phones", "emails",
                 "phone8", "email_norm", "sources")

    def __init__(self):
        self.name = None
        self.first = self.last = self.middle = ""
        self.nickname = self.org = self.title = self.department = ""
        self.birthday = None
        self.phones = []        # [(label, number)]
        self.emails = []        # [(label, address)]
        self.phone8 = set()     # 매칭용 last-8 자릿수
        self.email_norm = set()  # 매칭용 소문자 이메일
        self.sources = set()    # 기여한 소스 id(짧은 UUID)

    def to_dict(self):
        return {
            "name": self.name,
            "first": self.first or None,
            "last": self.last or None,
            "nickname": self.nickname or None,
            "org": self.org or None,
            "title": self.title or None,
            "department": self.department or None,
            "phones": [{"label": l, "number": n} for l, n in self.phones],
            "emails": [{"label": l, "address": a} for l, a in self.emails],
            "birthday": self.birthday,
            "sources": sorted(self.sources),
        }


def _source_id(db_path):
    """Sources/<UUID>/... 경로에서 짧은 식별자. 메인 DB는 'main'."""
    parent = os.path.basename(os.path.dirname(db_path))
    if parent == "AddressBook":
        return "main"
    return parent[:8]


def _addressbook_dbs():
    paths = [p for p in glob.glob(ADDRESSBOOK_GLOB, recursive=True)
             if os.path.exists(p)]
    if ADDRESSBOOK_MAIN not in paths and os.path.exists(ADDRESSBOOK_MAIN):
        paths.append(ADDRESSBOOK_MAIN)
    return paths


def load_cards():
    """모든 AddressBook DB를 읽어 병합된 Card 리스트를 돌려준다.

    같은 이름끼리 묶은 뒤, 핸들(전화/이메일)을 하나라도 공유하면 한 사람으로
    병합한다(union-find). 핸들이 겹치지 않는 동명이인은 따로 둔다.
    AddressBook을 못 읽으면 빈 리스트(친절 저하).
    """
    raw = []  # 소스별 레코드(병합 전)
    for db in _addressbook_dbs():
        con = _connect_ro(db)
        if con is None:
            continue
        try:
            raw.extend(_load_one(con, _source_id(db)))
        except sqlite3.Error:
            pass
        finally:
            con.close()
    return _merge(raw)


def _connect_ro(db):
    """Read-only connection. Prefer mode=ro (sees the -wal sidecar, so a contact
    just added via Contacts.app is visible immediately); fall back to immutable=1
    which ignores the WAL but opens even a locked/odd DB. Both are read-only —
    the file is never modified."""
    for uri in (f"file:{db}?mode=ro", f"file:{db}?mode=ro&immutable=1"):
        try:
            return sqlite3.connect(uri, uri=True)
        except sqlite3.Error:
            continue
    return None


def _load_one(con, src):
    recs = {}  # Z_PK -> Card
    for pk, fn, ln, mn, nick, org, title, dept, bday in con.execute(
        "SELECT Z_PK, ZFIRSTNAME, ZLASTNAME, ZMIDDLENAME, ZNICKNAME, "
        "ZORGANIZATION, ZJOBTITLE, ZDEPARTMENT, ZBIRTHDAY FROM ZABCDRECORD"
    ):
        nm = compose_name(fn, ln, mn, nick, org)
        if not nm:
            continue
        c = Card()
        c.name = nm
        c.first, c.last, c.middle = (fn or ""), (ln or ""), (mn or "")
        c.nickname, c.org = (nick or ""), (org or "")
        c.title, c.department = (title or ""), (dept or "")
        c.birthday = cocoa_to_date(bday)
        c.sources.add(src)
        recs[pk] = c
    for owner, label, num in con.execute(
        "SELECT ZOWNER, ZLABEL, ZFULLNUMBER FROM ZABCDPHONENUMBER "
        "WHERE ZFULLNUMBER IS NOT NULL"
    ):
        c = recs.get(owner)
        if not c:
            continue
        d = digits(num)
        c.phones.append((clean_label(label), num.strip()))
        if d:
            c.phone8.add(d[-8:])
    for owner, label, addr in con.execute(
        "SELECT ZOWNER, ZLABEL, ZADDRESS FROM ZABCDEMAILADDRESS "
        "WHERE ZADDRESS IS NOT NULL"
    ):
        c = recs.get(owner)
        if not c:
            continue
        e = addr.strip()
        c.emails.append((clean_label(label), e))
        c.email_norm.add(e.lower())
    return list(recs.values())


def _merge(raw):
    """이름 그룹 안에서 핸들을 공유하는 레코드를 union-find로 병합."""
    groups = {}
    for c in raw:
        groups.setdefault(c.name.strip().lower(), []).append(c)

    merged = []
    for items in groups.values():
        parent = list(range(len(items)))

        def find(i):
            while parent[i] != i:
                parent[i] = parent[parent[i]]
                i = parent[i]
            return i

        def union(i, j):
            parent[find(i)] = find(j)

        # 핸들(전화8/이메일) → 해당 레코드 인덱스로 연결
        by_handle = {}
        for idx, c in enumerate(items):
            for h in (("p", p) for p in c.phone8):
                by_handle.setdefault(h, idx)
            for h in (("e", e) for e in c.email_norm):
                by_handle.setdefault(h, idx)
        seen_handle = {}
        for idx, c in enumerate(items):
            for h in [("p", p) for p in c.phone8] + [("e", e) for e in c.email_norm]:
                if h in seen_handle:
                    union(idx, seen_handle[h])
                else:
                    seen_handle[h] = idx

        clusters = {}
        for idx in range(len(items)):
            clusters.setdefault(find(idx), []).append(items[idx])
        for cluster in clusters.values():
            merged.append(_combine(cluster))
    merged.sort(key=lambda c: c.name)
    return merged


def _combine(cluster):
    """같은 사람으로 판정된 레코드들을 하나의 Card로 합친다."""
    base = cluster[0]
    seen_ph, seen_em = set(), set()
    phones, emails = [], []
    for c in cluster:
        # 스칼라 필드: 비어있으면 다른 소스 값으로 채움
        for f in ("first", "last", "middle", "nickname", "org",
                  "title", "department"):
            if not getattr(base, f) and getattr(c, f):
                setattr(base, f, getattr(c, f))
        if not base.birthday and c.birthday:
            base.birthday = c.birthday
        for label, num in c.phones:
            key = digits(num)[-8:] or num
            if key not in seen_ph:
                seen_ph.add(key)
                phones.append((label, num))
        for label, addr in c.emails:
            key = addr.lower()
            if key not in seen_em:
                seen_em.add(key)
                emails.append((label, addr))
        base.phone8 |= c.phone8
        base.email_norm |= c.email_norm
        base.sources |= c.sources
    base.phones, base.emails = phones, emails
    return base


# --------------------------------------------------------------------------
# 검색 / 매칭
# --------------------------------------------------------------------------
def search_cards(cards, query):
    """이름·별명·소속·직함·번호·이메일 부분일치(대소문자 무시)."""
    q = query.strip().lower()
    qd = digits(query)
    out = []
    for c in cards:
        hay = " ".join(filter(None, [
            c.name, c.nickname, c.org, c.title, c.department,
            " ".join(a for _, a in c.emails),
        ])).lower()
        if q and q in hay:
            out.append(c)
            continue
        if qd and len(qd) >= 4 and any(qd[-8:] in p or p in qd for p in c.phone8):
            out.append(c)
    return out


def lookup_handle(cards, handle):
    """전화/이메일 핸들 → 매칭 Card 리스트."""
    out = []
    if "@" in handle:
        h = handle.strip().lower()
        out = [c for c in cards if h in c.email_norm]
    else:
        d = digits(handle)
        if d:
            key = d[-8:]
            out = [c for c in cards if key in c.phone8]
    return out


# --------------------------------------------------------------------------
# 출력
# --------------------------------------------------------------------------
def _fmt_card(c, full=True):
    lines = [c.name]
    sub = " · ".join(filter(None, [c.title, c.department, c.org]))
    if sub:
        lines.append(f"  {sub}")
    if c.nickname:
        lines.append(f"  ({c.nickname})")
    for label, num in c.phones:
        lines.append(f"  📞 {num}" + (f"  [{label}]" if label else ""))
    for label, addr in c.emails:
        lines.append(f"  ✉️  {addr}" + (f"  [{label}]" if label else ""))
    if full and c.birthday:
        lines.append(f"  🎂 {c.birthday}")
    return "\n".join(lines)


def _fmt_brief(c):
    bits = [c.name]
    if c.org:
        bits.append(f"({c.org})")
    p = c.phones[0][1] if c.phones else (c.emails[0][1] if c.emails else "")
    if p:
        bits.append(f"— {p}")
    return " ".join(bits)


def _print_cards(cards, as_json, brief=False):
    if as_json:
        print(json.dumps([c.to_dict() for c in cards],
                         ensure_ascii=False, indent=2))
        return
    if not cards:
        print("(일치하는 연락처 없음)")
        return
    if brief:
        for c in cards:
            print(_fmt_brief(c))
    else:
        print(("\n\n").join(_fmt_card(c) for c in cards))


# --------------------------------------------------------------------------
# 쓰기 (add) — 유일한 비-read-only 경로. abcddb는 절대 안 건드리고,
# Contacts.app 을 osascript 로 구동해 카드를 만든다(공식 경로, iCloud 동기화 정상).
# 이름/번호/이메일은 AppleScript 문자열 보간이 아니라 argv 로 넘겨 인젝션을 원천 차단한다
# (messages-cli send 와 같은 패턴). 전화 개수·이메일 개수를 argv 안에 정수로 실어 파싱.
# --------------------------------------------------------------------------
_ADD_APPLESCRIPT = r'''on run argv
  set theFirst to item 1 of argv
  set theLast to item 2 of argv
  set theOrg to item 3 of argv
  set theTitle to item 4 of argv
  set nPhones to (item 5 of argv) as integer
  set i to 6
  tell application "Contacts"
    set p to make new person with properties {first name:theFirst, last name:theLast}
    if theOrg is not "" then set organization of p to theOrg
    if theTitle is not "" then set job title of p to theTitle
    if theFirst is "" and theLast is "" and theOrg is not "" then set company of p to true
    repeat nPhones times
      make new phone at end of phones of p with properties {label:"mobile", value:(item i of argv)}
      set i to i + 1
    end repeat
    set nEmails to (item i of argv) as integer
    set i to i + 1
    repeat nEmails times
      make new email at end of emails of p with properties {label:"home", value:(item i of argv)}
      set i to i + 1
    end repeat
    save
    return id of p
  end tell
end run
'''


def add_via_contacts(first, last, org, title, phones, emails):
    """Create a person in Contacts.app via osascript. Returns (ok, message).

    All values ride in argv (no escaping pitfalls). Writes to the DEFAULT
    account (usually iCloud). Requires Automation permission for Contacts.
    """
    argv = [first, last, org, title, str(len(phones)), *phones,
            str(len(emails)), *emails]
    try:
        p = subprocess.run(
            ["osascript", "-", *argv],
            input=_ADD_APPLESCRIPT, text=True,
            capture_output=True, timeout=30,
        )
    except FileNotFoundError:
        return False, "osascript를 찾을 수 없습니다 (macOS 전용 기능입니다)."
    except subprocess.TimeoutExpired:
        return False, "시간 초과 — Automation 권한 팝업이 떠 있는지 확인하세요."
    if p.returncode == 0:
        return True, (p.stdout or "").strip()
    err = (p.stderr or p.stdout or "").strip()
    if "-1743" in err or "Not authorized" in err or "not allowed" in err:
        return False, (
            "Contacts 제어 권한이 없습니다 (Automation 필요).\n"
            "System Settings > Privacy & Security > Automation 에서\n"
            "이 명령을 실행하는 터미널 앱에 'Contacts' 제어를 허용한 뒤 다시 시도하세요.")
    return False, f"연락처 생성 실패: {err}"


def _resolve_name(args):
    """(first, last) 결정. --first/--last 우선, 없으면 표시이름을 규칙대로 분해."""
    if args.first is not None or args.last is not None:
        return (args.first or "").strip(), (args.last or "").strip()
    dn = (args.name or "").strip()
    if not dn:
        return "", ""
    # CJK 또는 단일 토큰: 통째로 last 에(한국어 정렬·표시가 자연스러움).
    # 서양식(공백 포함, 비CJK): 마지막 토큰만 last, 나머지 first.
    if _has_cjk(dn) or " " not in dn:
        return "", dn
    head, _, tail = dn.rpartition(" ")
    return head.strip(), tail.strip()


def cmd_add(cards, args):
    first, last = _resolve_name(args)
    org = (args.org or "").strip()
    title = (args.title or "").strip()
    phones = [p.strip() for p in (args.phone or []) if p.strip()]
    emails = [e.strip() for e in (args.email or []) if e.strip()]

    if not (first or last or org):
        _die("이름(표시이름 또는 --first/--last) 또는 --org 중 하나는 필요합니다.")

    disp = compose_name(first, last, "", "", org) or (org or "(이름없음)")

    # 미리보기
    lines = [f"─ 생성 미리보기 ─", f"  이름   : {disp}"
             + (f"   (first={first!r} last={last!r})" if (first or last) else "")]
    if org:
        lines.append(f"  소속   : {org}" + (f" / {title}" if title else ""))
    elif title:
        lines.append(f"  직함   : {title}")
    for n in phones:
        lines.append(f"  📞 {n}  [mobile]")
    for e in emails:
        lines.append(f"  ✉️  {e}  [home]")
    lines.append("  대상   : 기본 계정(보통 iCloud) — 이후 동기화됨")
    preview = "\n".join(lines)

    # 중복 검색: 진짜 중복 신호만 — 전체 표시이름 + 각 핸들(전화/이메일).
    # first/last/org 조각을 따로 검색하면 '우' 같은 1글자에 수백 건 오탐이 난다.
    dupes = []
    seen = set()
    for q in filter(None, [disp, *phones, *emails]):
        hits = lookup_handle(cards, q) if ("@" in q or digits(q)) else search_cards(cards, q)
        for c in hits:
            if id(c) not in seen:
                seen.add(id(c))
                dupes.append(c)

    print(preview)
    if dupes:
        print(f"\n⚠️ 비슷한 기존 연락처 {len(dupes)}건:")
        for c in dupes[:8]:
            print("  " + _fmt_brief(c))

    if args.dry_run:
        print("\n(--dry-run: 실제로 생성하지 않았습니다)")
        return

    if dupes and not args.force:
        _die("\n중복 가능성 때문에 중단했습니다. 그래도 만들려면 --force 를 붙이세요.")

    if not args.force:
        if not sys.stdin.isatty():
            _die("\n확인이 필요합니다 (비대화형). 바로 만들려면 --force 를 붙이세요.")
        try:
            ans = input("\n위 내용으로 연락처를 만들까요? [y/N] : ").strip().lower()
        except EOFError:
            ans = ""
        if ans not in ("y", "yes"):
            print("취소했습니다.")
            return

    ok, msg = add_via_contacts(first, last, org, title, phones, emails)
    if not ok:
        _die(msg)
    print(f"✓ 연락처 생성됨: {disp}")
    print("  (로컬엔 바로 반영됨. 다른 기기로의 iCloud 동기화는 잠시 걸릴 수 있음)")


# --------------------------------------------------------------------------
# 명령
# --------------------------------------------------------------------------
def cmd_search(cards, args):
    _print_cards(search_cards(cards, args.query), args.json)


def cmd_show(cards, args):
    hits = search_cards(cards, args.query)
    if args.json:
        _print_cards(hits, True)
        return
    if not hits:
        print("(일치하는 연락처 없음)")
    elif len(hits) == 1:
        print(_fmt_card(hits[0]))
    else:
        print(f"{len(hits)}명 매칭 — 더 구체적으로 좁히세요:\n")
        for c in hits:
            print("  " + _fmt_brief(c))


def cmd_lookup(cards, args):
    _print_cards(lookup_handle(cards, args.handle), args.json, brief=not args.json)


def cmd_list(cards, args):
    if args.limit:
        cards = cards[:args.limit]
    _print_cards(cards, args.json, brief=not args.json)


def main(argv=None):
    p = argparse.ArgumentParser(
        prog="contacts", description="macOS 연락처(AddressBook) 조회 — 읽기 전용")
    sub = p.add_subparsers(dest="cmd")

    def add_json(sp):
        sp.add_argument("--json", action="store_true", help="JSON 출력")

    sp = sub.add_parser("search", help="이름·소속·번호·이메일로 검색")
    sp.add_argument("query")
    add_json(sp)

    sp = sub.add_parser("show", help="단일 인물 전체 카드")
    sp.add_argument("query")
    add_json(sp)

    sp = sub.add_parser("lookup", help="전화/이메일 → 이름 역조회")
    sp.add_argument("handle")
    add_json(sp)

    sp = sub.add_parser("list", help="전체 연락처 간략 목록")
    sp.add_argument("--limit", type=int, default=0)
    add_json(sp)

    sp = sub.add_parser("add", help="연락처 생성(Contacts.app 경유, 미리보기+확인)")
    sp.add_argument("name", nargs="?", help="표시이름(--first/--last 없을 때)")
    sp.add_argument("--first", help="이름(first name)")
    sp.add_argument("--last", help="성(last name)")
    sp.add_argument("--org", help="소속/회사")
    sp.add_argument("--title", help="직함")
    sp.add_argument("--phone", action="append", help="전화(여러 번 가능)")
    sp.add_argument("--email", action="append", help="이메일(여러 번 가능)")
    sp.add_argument("--force", action="store_true", help="확인·중복경고 건너뛰고 생성")
    sp.add_argument("--dry-run", action="store_true", help="미리보기만, 생성 안 함")

    raw = list(sys.argv[1:] if argv is None else argv)
    # 서브커맨드 없이 `contacts <query>` 도 search 로 처리
    known = {"search", "show", "lookup", "list", "add", "-h", "--help"}
    if not raw:
        p.print_help()
        return
    if raw[0] not in known:
        q = " ".join(a for a in raw if a != "--json")
        ns = argparse.Namespace(query=q, json=("--json" in raw))
        cmd_search(load_cards(), ns)
        return

    args = p.parse_args(raw)
    if args.cmd is None:
        p.print_help()
        return
    cards = load_cards()
    {"search": cmd_search, "show": cmd_show, "lookup": cmd_lookup,
     "list": cmd_list, "add": cmd_add}[args.cmd](cards, args)


if __name__ == "__main__":
    try:
        main()
    except BrokenPipeError:
        try:
            sys.stdout.close()
        except Exception:
            pass
